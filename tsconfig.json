{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2020",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@zaes/symbology-engine": [
        "packages/engine/src/index.ts"
      ],
      "@zaes/symbology-engine/openlayers": [
        "packages/engine/src/openlayers/index.ts"
      ],
      "@zaes/symbology-engine/maplibre": [
        "packages/engine/src/maplibre/index.ts"
      ],
      "@zaes/symbology-editor": [
        "packages/engine-editor/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "vitest.config.mts"
  ]
}
